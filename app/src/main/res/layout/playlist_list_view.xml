<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        android:id="@+id/playlist_cover"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/short_padding"
        android:layout_marginStart="@dimen/medium_short_padding"
        android:src="@drawable/placeholder"/>

    

        <TextView
            app:layout_constraintStart_toEndOf="@+id/playlist_cover"
            app:layout_constraintTop_toTopOf="@+id/playlist_cover"
            android:id="@+id/playlist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="@dimen/short_padding"
            android:layout_marginStart="@dimen/short_padding"
            android:textColor="?attr/colorOnPrimary"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="@dimen/low_text_size"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Track name"/>



            <TextView
                app:layout_constraintStart_toEndOf="@+id/playlist_cover"
                app:layout_constraintTop_toBottomOf="@+id/playlist_name"
                android:id="@+id/size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:textColor="?attr/colorOnPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/low_low_text_size"
                android:layout_marginStart="@dimen/short_padding"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="size"/>




    </androidx.constraintlayout.widget.ConstraintLayout>