<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:orientation="vertical">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/placeholder" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/black"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cover"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/long_padding"
        android:layout_marginStart="@dimen/medium_padding"
        android:textFontWeight="700"
        android:fontFamily="@font/ys_display_bold"
        android:textSize="@dimen/hi_text_size"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@null"
        tools:text="Playlist name"/>

    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/short_padding"
        android:layout_marginStart="@dimen/medium_padding"
        android:textFontWeight="400"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="@dimen/low_text_size"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@null"
        tools:text="Description"/>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/short_padding"
        android:layout_marginStart="@dimen/medium_padding"
        android:textFontWeight="400"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="@dimen/low_text_size"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@null"
        tools:text="Duration"/>

    <TextView
        android:id="@+id/size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintStart_toEndOf="@+id/point"
        android:layout_marginStart="5dp"
        android:layout_marginTop="@dimen/short_padding"
        android:textFontWeight="400"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="@dimen/low_text_size"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@null"
        tools:text="Size"/>

    <ImageView
        android:id="@+id/point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@+id/duration"
        app:layout_constraintTop_toTopOf="@+id/duration"
        app:layout_constraintBottom_toBottomOf="@+id/duration"
        android:src="@drawable/ellipse_1"/>

    <ImageView
        android:id="@+id/share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/duration"
        android:layout_marginTop="@dimen/medium_padding"
        android:layout_marginStart="@dimen/medium_padding"
        android:src="@drawable/ic_share_black_24"/>

    <ImageView
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/share"
        app:layout_constraintTop_toBottomOf="@+id/duration"
        android:layout_marginTop="@dimen/medium_padding"
        android:layout_marginStart="@dimen/medium_padding"
        android:src="@drawable/ic_menu_24"/>

</androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/standard_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="266dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <ImageView
            android:id="@+id/info_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/long_padding"
            android:src="@drawable/ic_nothing_was_found_light_120"/>

        <TextView
            android:id="@+id/info_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Треков еще нет"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPlaylist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/long_padding"/>
    </LinearLayout>

    <View android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/menu_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="383dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/long_padding">

            <ImageView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1:1"
                android:id="@+id/menu_playlist_cover"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginVertical="@dimen/short_padding"
                android:layout_marginStart="@dimen/medium_short_padding"
                android:src="@drawable/placeholder"/>

            <TextView
                app:layout_constraintStart_toEndOf="@+id/menu_playlist_cover"
                app:layout_constraintTop_toTopOf="@+id/menu_playlist_cover"
                android:id="@+id/menu_playlist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginTop="@dimen/short_padding"
                android:layout_marginStart="@dimen/short_padding"
                android:textColor="?attr/colorOnPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/low_text_size"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Track name"/>

            <TextView
                app:layout_constraintStart_toEndOf="@+id/menu_playlist_cover"
                app:layout_constraintTop_toBottomOf="@+id/menu_playlist_name"
                android:id="@+id/menu_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:textColor="?attr/colorOnPrimary"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/low_low_text_size"
                android:layout_marginStart="@dimen/short_padding"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="size"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/menu_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/short_padding"
            android:paddingStart="@dimen/medium_padding"
            android:paddingVertical="@dimen/long_medium_padding"
            android:textSize="@dimen/low_text_size"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textColor="?attr/colorOnPrimary"
            android:layout_gravity="start"
            android:text="Поделиться"/>

        <TextView
            android:id="@+id/edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/medium_padding"
            android:paddingVertical="@dimen/long_medium_padding"
            android:textSize="@dimen/low_text_size"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textColor="?attr/colorOnPrimary"
            android:layout_gravity="start"
            android:text="Редактировать информацию"/>

        <TextView
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/medium_padding"
            android:paddingVertical="@dimen/long_medium_padding"
            android:textSize="@dimen/low_text_size"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textColor="?attr/colorOnPrimary"
            android:layout_gravity="start"
            android:text="Удалить плейлист"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>